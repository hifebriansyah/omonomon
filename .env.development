# Same public values for `npm run dev` and Storybook (see .env.production).
# Secrets never go in a VITE_ variable; they stay in .env (git-ignored) without the prefix. vite.config.ts refuses a VITE_ name
# with TOKEN, SECRET or KEY in it, except the two public keys below.
# The Gemini Worker. Empty: only the local JSON rules answer.
VITE_WORKER_URL=https://geminimon.securhat.com/
# Google sign-in client ID (public; the client secret is never used here).
VITE_GOOGLE_CLIENT_ID=620395952409-mv96o61s4ep74n5vuohqvvk23tvt0i6p.apps.googleusercontent.com
# The API Worker (sign-in, saved progress, whispers). Empty: progress stays in this browser only.
VITE_API_URL=https://apimon.securhat.com
# Cloudflare Turnstile site key (public; the secret is only on the API Worker).
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFkXHkvt4ycF-6F2
# Web Push public key (VAPID, public; the private key is only on the API Worker).
VITE_VAPID_PUBLIC_KEY=BNZDVw8U0zL8c3IBTZNziTyTToDQq-lHqthmdaE9ScHdRZpm05gPf8sSuCQyzntFI6rm5JWjWvQ9uxX6IxxHw_s
# Longest message a visitor can send (saves tokens).
VITE_INPUT_MAX_CHARS=200
# Recent messages sent to Gemini for context.
VITE_HISTORY_TURNS=8
# Give up on Gemini after this long and use the local rules.
VITE_TIMEOUT_MS=15000
