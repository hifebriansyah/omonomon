# Copy to .env (git-ignored) and fill in. Never commit the real file.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
AXIOM_TOKEN=
# A long random value shared by both Workers (python3 -c "import secrets; print(secrets.token_urlsafe(32))")
INTERNAL_TOKEN=
# Optional: a YouTube Data API v3 key (Google Cloud > APIs > YouTube Data API v3 > Credentials). With it, some whispers point to popular
# videos from Indonesian channels. Without it, whispers use news articles and trending topics only.
YOUTUBE_API_KEY=
# Optional: the secret of a Cloudflare Turnstile widget. With it, creating an account needs a passed bot check (the site key goes in config.js).
TURNSTILE_SECRET=
# Optional: the private key (as one line of JWK JSON) of the Web Push VAPID pair. With it, the API Worker can send "a ghost whispered" and streak reminders.
VAPID_PRIVATE_JWK=
