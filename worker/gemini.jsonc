{
  // The Gemini chat Worker (worker/gemini.js): character replies and the request log (Axiom). Nothing else lives here,
  // so the Gemini key and budget are touched by this code only. Deployed by: python3 tools/deploy_worker.py
  "name": "omonomon-gemini",
  "main": "gemini.js",
  "compatibility_date": "2025-09-01",
  // The public address the page calls (config.js WORKER_URL). One level below securhat.com, so Cloudflare's free
  // certificate covers it. tools/deploy_worker.py attaches it and turns the workers.dev address off.
  "domain": "geminimon.securhat.com",
  // Where the Worker runs. Google does not serve the Gemini API from every place Cloudflare has a data centre (requests
  // handled in Hong Kong are refused with "User location is not supported"), so the Worker is pinned near Singapore
  // instead of running wherever the visitor happens to arrive.
  "placement": { "region": "aws:ap-southeast-1" },
  // Plain (non-secret) variables, set on every deploy.
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost,https://omonomon.securhat.com,https://hifebriansyah.github.io",
    "THINKING_BUDGET": "0",
    // Ghost comments and replies under whispers (the whisper itself and the chat stay on gemini-3.8-flash).
    "REACTION_MODEL": "gemini-3.5-flash-lite"
  },
  // Secrets are never in the repo. GEMINI_API_KEY: enter it in the Cloudflare dashboard (Worker > Settings >
  // Variables and Secrets). AXIOM_TOKEN: put it in .env and the deploy script sets it. Deploys keep both.
  // Per-visitor limit: at most 20 chat requests a minute from one IP address (checked in gemini.js).
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ]
}
