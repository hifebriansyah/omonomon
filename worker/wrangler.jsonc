{
  // Used by Cloudflare's Git integration to deploy worker.js on every push.
  // "name" must match the Worker you already created, so it updates in place.
  "name": "indonomon",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  // Keep the variables you set in the dashboard (ALLOWED_ORIGINS, GEMINI_MODEL, ...).
  // The secret GEMINI_API_KEY is never touched by deploys.
  "keep_vars": true
}
