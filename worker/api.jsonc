{
  // The general API Worker (worker/api.js): accounts and saved game progress today, more later. Separate from the
  // Gemini Worker so nothing here can touch the Gemini key or budget. Deployed by: python3 tools/deploy_worker.py api
  "name": "omonomon-api",
  "main": "api.js",
  "compatibility_date": "2025-09-01",
  // The public address the page calls (config.js API_URL). One level below securhat.com, so Cloudflare's free
  // certificate covers it. tools/deploy_worker.py attaches it and turns the workers.dev address off.
  "domain": "apimon.securhat.com",
  // D1 database (name "omonomon"). Its id is written to worker/api-db.json by tools/setup_api.py.
  "d1": { "binding": "DB", "name": "omonomon" },
  // R2 bucket (object storage) for the link pictures that were redone because the source's was too small. Created by
  // tools/setup_api.py; the Worker reaches it as env.IMAGES and serves the files itself, so the bucket stays private.
  // (Redone pictures are 1-2 MB each, which is why this is R2 and not Workers KV.)
  "r2": { "binding": "IMAGES", "bucket": "omonomon-images" },
  // Plain (non-secret) variables, set on every deploy.
  "vars": {
    "GOOGLE_CLIENT_ID": "620395952409-mv96o61s4ep74n5vuohqvvk23tvt0i6p.apps.googleusercontent.com",
    "ALLOWED_ORIGINS": "https://omonomon.securhat.com,http://localhost",
    "GEMINI_URL": "https://geminimon.securhat.com/whisper",
    "GEMINI_COMMENT_URL": "https://geminimon.securhat.com/comment",
    "SITE_ORIGIN": "https://omonomon.securhat.com",
    "VAPID_SUBJECT": "mailto:securhat@googlegroups.com"
  },
  // The timer: every 15 minutes one ghost writes a new whisper, so each ghost posts once an hour (order shuffled per hour,
  // never the same ghost twice in a row). Free plans allow a few cron triggers per account.
  "crons": ["*/15 * * * *"],
  // At most 60 requests a minute from one IP address.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    // posting comments (each one is a Gemini call): at most 12 a minute from one IP address. Many people can share one address
    // on a mobile network, so this is generous; the real cost caps are 10 comments per browser a day and 300 a day in total.
    { "name": "COMMENT_LIMITER", "namespace_id": "1003", "simple": { "limit": 12, "period": 60 } }
  ]
}
